/* ============================================================================
   ICONS
   Vector icon system backed by SVGs in Resources/Textures/Icons/.
   Each .ds-icon--<name> class binds the icon's background-image; the parent
   element (.ds-icon-host or any control with .ds-btn--icon, .ds-tab, etc.)
   drives the tint color via -unity-background-image-tint-color so the SAME
   class supports passive / hover / active / disabled states automatically.

   Usage on its own VisualElement (e.g., as a label-prefix glyph):
     <ui:VisualElement class="ds-icon ds-icon--paw" />

   Usage inside an icon button or tab (recommended):
     <ui:Button class="ds-btn ds-btn--icon">
       <ui:VisualElement class="ds-icon ds-icon--search" />
     </ui:Button>

   Color states inherit from the parent's pseudo-class — no additional rule
   needed in the consumer screen. To override a single state, add a
   stateful modifier (.ds-icon--accent, .ds-icon--danger, etc.).
   ============================================================================ */

/* ---------- Base ---------- */

.ds-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    flex-grow: 0;
    -unity-background-scale-mode: scale-to-fit;
    /* Default tint = text-secondary (passive). Parent state overrides. */
    -unity-background-image-tint-color: var(--color-text-secondary);
    transition-property: -unity-background-image-tint-color;
    transition-duration: var(--transition-fast);
}

/* ---------- Sizes ---------- */
.ds-icon--xs {
    width: 12px;
    height: 12px;
}

.ds-icon--sm {
    width: 16px;
    height: 16px;
}

.ds-icon--md {
    width: 20px;
    height: 20px;
}

.ds-icon--lg {
    width: 24px;
    height: 24px;
}

.ds-icon--xl {
    width: 32px;
    height: 32px;
}

.ds-icon--xxl {
    width: 48px;
    height: 48px;
}

/* ---------- Tint variants (explicit) ---------- */
.ds-icon--primary {
    -unity-background-image-tint-color: var(--color-text-primary);
}

.ds-icon--secondary {
    -unity-background-image-tint-color: var(--color-text-secondary);
}

.ds-icon--disabled {
    -unity-background-image-tint-color: var(--color-text-disabled);
}

.ds-icon--accent {
    -unity-background-image-tint-color: var(--color-primary);
}

.ds-icon--gold {
    -unity-background-image-tint-color: var(--color-rarity-legendary);
}

.ds-icon--danger {
    -unity-background-image-tint-color: var(--color-danger);
}

.ds-icon--warning {
    -unity-background-image-tint-color: var(--color-warning);
}

.ds-icon--info {
    -unity-background-image-tint-color: var(--color-secondary);
}

.ds-icon--on-accent {
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.ds-icon--rarity-common {
    -unity-background-image-tint-color: var(--color-rarity-common);
}

.ds-icon--rarity-rare {
    -unity-background-image-tint-color: var(--color-rarity-rare);
}

.ds-icon--rarity-epic {
    -unity-background-image-tint-color: var(--color-rarity-epic);
}

.ds-icon--rarity-legendary {
    -unity-background-image-tint-color: var(--color-rarity-legendary);
}

/* ---------- Parent-driven state inheritance ----------
   When an icon sits inside a control (button / tab / nav-item) that exposes
   :hover / :active / :disabled / .is-active, paint the icon to match. The
   selectors target the icon directly so we don't have to repeat per-state
   rules in every consumer. */

/* Hover on a generic interactive parent */
.ds-btn:hover .ds-icon,
.ds-tab:hover .ds-icon,
.ds-nav-item:hover .ds-icon,
.ds-rail-item:hover .ds-icon,
.ds-bottom-nav__item:hover .ds-icon,
.ds-pagination__btn:hover .ds-icon,
.ds-stepper__btn:hover .ds-icon {
    -unity-background-image-tint-color: var(--color-text-primary);
}

/* Active state. Two flavours:
   1. Filled-bg controls (.ds-tab, .ds-pagination__btn, .ds-view-toggle__btn,
      .ds-bottom-nav__item — when active the tab is painted with primary
      background) → on-accent ink for contrast.
   2. Soft-bg controls (.ds-nav-item, .ds-rail-item — primary-soft fill,
      primary-tinted icon) — those define their own per-class tint in
      Navigation.uss; we don't add them to this list to avoid stomping. */
.ds-tab.is-active .ds-icon,
.ds-pagination__btn.is-active .ds-icon,
.ds-view-toggle__btn.is-active .ds-icon {
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

/* .ds-bottom-nav__item.is-active uses primary tint on transparent fill
   (no full-green background) — its __icon rule in Navigation.uss already
   sets that, so we skip it here too. */

/* Press feedback */
.ds-btn:active .ds-icon,
.ds-tab:active .ds-icon,
.ds-nav-item:active .ds-icon,
.ds-rail-item:active .ds-icon,
.ds-bottom-nav__item:active .ds-icon,
.ds-pagination__btn:active .ds-icon {
    -unity-background-image-tint-color: var(--color-text-primary);
}

/* Disabled — base rule plus explicit `:disabled:hover` / `:disabled:active`
   compounds. The per-variant `:hover` / `:active` rules below
   (`.ds-btn--ghost:hover .ds-icon` etc.) are also (0,3,0); the bare
   `.ds-btn:disabled .ds-icon` at the same (0,3,0) specificity LOSES on
   source order because the per-variant rules are declared later in the
   file. Without these compounds at (0,4,0), moving the cursor onto a
   disabled button would flash its icon from the disabled grey back to the
   variant's text-primary / text-on-accent tint. The same trap applies to
   `:active` — Unity's input layer can still produce pointer-down on a
   disabled element on some platforms before SetEnabled blocks it, leaving
   a one-frame "pressed" tint mismatch. Lock both states to disabled. */
.ds-btn:disabled .ds-icon,
.ds-btn:disabled:hover .ds-icon,
.ds-btn:disabled:active .ds-icon,
.ds-tab:disabled .ds-icon,
.ds-tab:disabled:hover .ds-icon,
.ds-tab:disabled:active .ds-icon,
.ds-nav-item:disabled .ds-icon,
.ds-nav-item:disabled:hover .ds-icon,
.ds-nav-item:disabled:active .ds-icon,
.ds-pagination__btn:disabled .ds-icon,
.ds-pagination__btn:disabled:hover .ds-icon,
.ds-pagination__btn:disabled:active .ds-icon {
    -unity-background-image-tint-color: var(--color-text-disabled);
}

/* Per-variant glyph tint — match the icon to the variant's text color so
   a leading `.ds-btn__icon` reads as part of the same content stream as
   the label. Splits by what the variant's `color:` actually resolves to:

   .ds-btn--primary  → color: text-on-accent (dark ink on green) → icon dark
   .ds-btn--secondary→ color: text-primary  (white on blue)      → icon white
   .ds-btn--tertiary → color: text-primary  (white on purple)    → icon white
   .ds-btn--ghost    → color: text-primary  (white on transparent)→ icon white
   .ds-btn--danger   → color: text-primary  (white on red)       → icon white

   Each variant must also list `:hover` and `:active` selectors. The global
   `.ds-btn:hover .ds-icon` / `.ds-btn:active .ds-icon` rules above are
   (0,3,0) — pseudo-classes count as classes — so a bare `.ds-btn--primary
   .ds-icon` (0,2,0) actually LOSES the cascade on hover and the icon
   would flash to text-primary white over the green Primary background.
   Adding `.ds-btn--primary:hover .ds-icon` (0,3,0) ties the global rule
   on specificity; declaring it AFTER the global rule lets source order
   pick the variant tint, so a Primary button keeps its dark glyph on
   every interactive state and the dark "Back" label never disagrees with
   the chevron next to it. */
.ds-btn--primary .ds-icon,
.ds-btn--primary:hover .ds-icon,
.ds-btn--primary:active .ds-icon {
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.ds-btn--secondary .ds-icon,
.ds-btn--secondary:hover .ds-icon,
.ds-btn--secondary:active .ds-icon,
.ds-btn--tertiary .ds-icon,
.ds-btn--tertiary:hover .ds-icon,
.ds-btn--tertiary:active .ds-icon,
.ds-btn--ghost .ds-icon,
.ds-btn--ghost:hover .ds-icon,
.ds-btn--ghost:active .ds-icon,
.ds-btn--danger .ds-icon,
.ds-btn--danger:hover .ds-icon,
.ds-btn--danger:active .ds-icon {
    -unity-background-image-tint-color: var(--color-text-primary);
}

/* The icon-button variant defaults to text-primary at rest so the glyph
   stays legible against the surface-elev background. */
.ds-btn--icon .ds-icon {
    -unity-background-image-tint-color: var(--color-text-primary);
}

.ds-btn--icon:hover .ds-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.ds-btn--icon.ds-btn--icon-danger .ds-icon {
    -unity-background-image-tint-color: var(--color-danger);
}

/* ---------- Glyph map ---------------------------------------------------
   One declaration per SVG file under Assets/Resources/Textures/Icons/.
   Add a new file → add one line below. resource(...) is path-relative to
   Resources/, no extension. SVGs import as Texture2D (svgType: 3). */

/* Arrows */
.ds-icon--arrow-up {
    background-image: resource("Textures/Icons/arrow_up");
}

.ds-icon--arrow-down {
    background-image: resource("Textures/Icons/arrow_down");
}

.ds-icon--arrow-left {
