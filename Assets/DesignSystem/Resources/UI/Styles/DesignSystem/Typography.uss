/* ============================================================================
   TYPOGRAPHY
   Utility classes mirroring the design system's text styles.
   Apply alongside any element: <ui:Label class="ds-h1" .../>

   OLD: `white-space: normal` is set on every prose class because UI Toolkit's Label
   defaults to nowrap, which silently overflows on narrow viewports (a 412
   CSS-px Android phone with a 31-char heading goes off-screen instead of
   wrapping to two lines). nowrap is the right default for short single-word
   button labels — those use their own component classes and aren't affected.
   
   NEW: 'white-space: wrap' is used because this font bugs out with normal
   ============================================================================ */

.ds-h1 {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-left;
    white-space: wrap;
}

.ds-h2 {
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--color-text-primary);
    white-space: wrap;
}

.ds-h3 {
    font-size: var(--font-size-h3);
    -unity-font-style: bold; /* Semibold — UI Toolkit uses normal/bold; pair with a Semibold font asset for accuracy */
    color: var(--color-text-primary);
    white-space: wrap;
}

.ds-body-1 {
    font-size: var(--font-size-body-1);
    -unity-font-style: normal;
    color: var(--color-text-primary);
    white-space: wrap;
}

.ds-body-2 {
    font-size: var(--font-size-body-2);
    -unity-font-style: normal;
    color: var(--color-text-secondary);
    white-space: nowrap;
}

.ds-caption {
    font-size: var(--font-size-caption);
    -unity-font-style: bold; /* Medium — pair with a Medium font asset for fidelity */
    color: var(--color-text-secondary);
    letter-spacing: 0.5px;
}

* {
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.asset");
    white-space: nowrap;
}

/* Color modifiers */
.ds-text-primary {
    color: var(--color-text-primary);
}

.ds-text-secondary {
    color: var(--color-text-secondary);
}

.ds-text-disabled {
    color: var(--color-text-disabled);
}

.ds-text-success {
    color: var(--color-primary);
}

.ds-text-warning {
    color: var(--color-warning);
}

.ds-text-danger {
    color: var(--color-danger);
}

.ds-text-info {
    color: var(--color-secondary);
}

/* Section labels (small caps style headers like "COLORS", "TYPOGRAPHY") */
.ds-section-label {
    font-size: var(--font-size-caption);
    -unity-font-style: bold;
    color: var(--color-text-secondary);
    letter-spacing: 1px;
    margin-bottom: var(--space-3);
}
