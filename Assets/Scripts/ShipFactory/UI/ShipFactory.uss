/* Ship Factory — layout & behaviour only; visuals from DesignSystem.uss */

:root {
    flex-direction: column;
    width: 100%;
    height: 100%;

    --inset-from-edge: var(--space-2);
    --palette-height: 220px;
}

.spacer {
    flex-grow: 1;
}

.canvas-container {
    flex-grow: 1;
}

.canvas-viewport,
.canvas-area {
    position: absolute;
    width: 100%;
    height: 100%;
}

.top-bar {
    position: absolute;
    align-self: center;
    top: 0;
}

.camera-info {
    position: absolute;
    top: var(--inset-from-edge);
    right: var(--inset-from-edge);
}

.top-bar__cluster {
    margin-bottom: 0;
    padding: var(--space-2) var(--space-3);
}

.top-bar__name-field {
    min-width: 260px;
}

.module-info-panel .ds-info-row__label,
.module-info-panel .ds-info-row__value {
    font-size: var(--font-size-caption);
}

.palette-panel {
    flex-direction: row;
    flex-shrink: 0;
    height: var(--palette-height);
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.module-info-panel,
#resources-panel {
    position: absolute;
    flex-direction: column;
    bottom: 230px; /*calc(var(--palette-height) + var(--inset-from-edge));*/
    width: 300px;
}

.module-info-panel {
    left: var(--inset-from-edge);
}

#resources-panel {
    right: var(--inset-from-edge);
}

.hidden,
.module-rotation-buttons--hidden,
.remove-module-button--hidden,
.ship-factory-input-blocker,
.action-popup {
    display: none;
}

.module-info-body {
    margin-top: var(--space-2);
    overflow: hidden;
    transition-property: max-height, opacity, margin-top;
    transition-duration: var(--transition-medium);
    transition-timing-function: ease-out;
    max-height: 600px;
    opacity: 1;
}

.module-info-body--collapsed {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
}

.module-info-body--collapsed > * {
    margin-bottom: 0;
}

.module-info-body--no-transition,
.module-info-collapse-icon--no-transition {
    transition-duration: 0s;
}

.module-info-collapse-icon {
    transition-property: rotate;
    transition-duration: var(--transition-medium);
    transition-timing-function: ease-out;
}

.module-info-collapse-icon--collapsed {
    rotate: 180deg;
}

.ship-factory-input-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
}

.action-popup {
    position: absolute;
    top: 80px;
    align-self: center;
}

.palette-card {
    width: 132px;
    flex-shrink: 0;
    align-self: stretch;
    flex-direction: column;
}

.palette-card__title-clip {
    width: 100%;
}

.palette-card .ds-card__title-row {
    width: 100%;
}

.palette-card--dragging {
    opacity: 0.3;
}

.palette-card--disabled {
    opacity: 0.45;
}

.ds-nav-item:disabled {
    opacity: 0.45;
}

.ds-nav-item:disabled .ds-nav-item__label {
    color: var(--color-text-disabled);
}

.module-info-description-scroll {
    flex-shrink: 0;
    max-height: 48px;
}

.module-info-description {
    white-space: normal;
}
