/* Ship Factory — layout & behaviour only; visuals from DesignSystem.uss */

:root {
    flex-direction: column;
    width: 100%;
    height: 100%;

    --ship-factory-panel-inset: var(--space-2);
    --ship-factory-palette-height: 220px;
}

.spacer {
    flex-grow: 1;
}

.canvas-container {
    flex-grow: 1;
}

.canvas-viewport,
.canvas-area {
    position: absolute;
    width: 100%;
    height: 100%;
}

.top-bar {
    position: absolute;
    align-self: center;
    top: 0;
}

.camera-info {
    position: absolute;
    top: var(--ship-factory-panel-inset);
    right: var(--ship-factory-panel-inset);
}

.top-bar__cluster {
    margin-bottom: 0;
    padding: var(--space-2) var(--space-3);
}

.top-bar__name-field {
    min-width: 260px;
}

.module-info-panel .ds-info-row__label,
.module-info-panel .ds-info-row__value,
.ship-resources-panel .ds-info-row__label,
.ship-resources-panel .ds-info-row__value {
    font-size: var(--font-size-caption);
}

.palette-panel {
    flex-direction: row;
    flex-shrink: 0;
    height: var(--ship-factory-palette-height);
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.module-info-panel,
.ship-resources-panel {
    position: absolute;
    flex-direction: column;
    bottom: 230px; /*calc(var(--ship-factory-palette-height) + var(--ship-factory-panel-inset));*/
    width: 300px;
}

.module-info-panel {
    left: var(--ship-factory-panel-inset);
}

.ship-resources-panel {
    right: var(--ship-factory-panel-inset);
}

.ship-resource-bar-track {
    position: relative;
    height: 8px;
    overflow: hidden;
    background-color: var(--color-surface-elev);
    border-width: var(--border-thin);
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
}

.ship-resource-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

.hidden,
.module-rotation-buttons--hidden,
.remove-module-button--hidden,
.ship-factory-input-blocker,
.action-popup {
    display: none;
}

.module-info-body {
    margin-top: var(--space-2);
    overflow: hidden;
    transition-property: max-height, opacity, margin-top;
    transition-duration: var(--transition-medium);
    transition-timing-function: ease-out;
    max-height: 600px;
    opacity: 1;
}

.module-info-body--collapsed {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
}

.module-info-body--collapsed > * {
    margin-bottom: 0;
}

.module-info-body--no-transition,
.module-info-collapse-icon--no-transition {
    transition-duration: 0s;
}

.module-info-collapse-icon {
    transition-property: rotate;
    transition-duration: var(--transition-medium);
    transition-timing-function: ease-out;
}

.module-info-collapse-icon--collapsed {
    rotate: 180deg;
}

.ship-factory-input-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
}

.action-popup {
    position: absolute;
    top: 80px;
    align-self: center;
}

.palette-card--dragging {
    opacity: 0.3;
}

.module-info-description-scroll {
    flex-shrink: 0;
    max-height: 48px;
}

.module-info-description {
    white-space: normal;
}
