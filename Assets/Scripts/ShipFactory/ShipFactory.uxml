<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="ShipFactory.uss"/>
    <Style src="project://database/Assets/DesignSystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss"/>
    <ui:Template name="pauseOverlayTemplate" src="project://database/Assets/Scripts/UI/Common/PauseOverlay.uxml"/>
    <ui:Template name="settingsOverlayTemplate" src="project://database/Assets/Scripts/UI/Common/SettingsOverlay.uxml"/>

    <!-- Canvas area: drag-and-drop surface -->
    <ui:VisualElement name="canvas-container" class="canvas-container">
        <ui:VisualElement name="canvas-viewport" class="canvas-viewport">
            <ui:VisualElement name="canvas-area" class="canvas-area"/>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Top bar -->
    <ui:VisualElement name="top-bar" class="top-bar">
        <ui:VisualElement class="ds-card ds-row ds-row__gap top-bar__cluster"
                          style="border-top-left-radius: 0; border-top-right-radius: 0;">
            <ui:TextField name="ship-name-field" label="Name" value="Ship" class="ds-input top-bar__name-field"
                          max-length="64"/>
            <ui:Button name="save-ship-button" class="ds-btn ds-btn--primary ds-btn--with-icon">
                <ui:VisualElement class="ds-icon ds-icon--check ds-btn__icon"/>
                <ui:Label text="Save Snapshot"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Top right camera info -->
    <ui:VisualElement name="camera-info" class="camera-info ds-card ds-row ds-row__gap">
        <ui:VisualElement class="ds-icon ds-icon--camera ds-icon--sm"/>
        <ui:Label name="camera-info-position" text="(0, 0)" class="ds-caption"/>
        <ui:Button name="camera-reset-button" class="ds-btn ds-btn--secondary ds-btn--icon ds-btn--sm"
                   tooltip="Reset camera position and zoom">
            <ui:VisualElement class="ds-icon ds-icon--refresh ds-icon--sm"/>
        </ui:Button>
    </ui:VisualElement>

    <!-- Bottom-left details panel for dragged/selected modules -->
    <ui:VisualElement name="module-info-panel" class="ds-card module-info-panel">
        <ui:VisualElement class="ds-row" style="margin-bottom: 0px;">
            <ui:Label text="Module Details" class="ds-body-1"/>
            <ui:VisualElement class="spacer"/>
            <ui:Button name="module-info-collapse-button" class="ds-btn ds-btn-secondary ds-btn--icon ds-btn--ghost"
                       tooltip="Collapse panel">
                <ui:VisualElement name="module-info-collapse-icon"
                                  class="ds-icon ds-icon--sm ds-icon--chevron-down"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="module-info-body" class="ds-col-gap" style="margin-top: 8px;">
            <ui:Label name="module-info-name" text="No module selected" class="ds-caption ds-text-primary"/>
            <ui:ScrollView name="module-info-description-scroll"
                           class="module-info-description-scroll ds-scroll"
                           mode="Vertical" vertical-scroller-visibility="Auto"
                           horizontal-scroller-visibility="Hidden">
                <ui:Label name="module-info-description" text="Hover or drag a module to inspect it."
                          class="ds-caption module-info-description"/>
            </ui:ScrollView>
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Type" class="ds-info-row__label"/>
                <ui:Label name="module-info-type-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Dimensions" class="ds-info-row__label"/>
                <ui:Label name="module-info-size-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Energy Production" class="ds-info-row__label"/>
                <ui:Label name="module-info-resource-energy-production-value" text="-"
                          class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Energy Draw" class="ds-info-row__label"/>
                <ui:Label name="module-info-resource-energy-draw-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Energy Capacity" class="ds-info-row__label"/>
                <ui:Label name="module-info-resource-energy-capacity-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Crew Needed" class="ds-info-row__label"/>
                <ui:Label name="module-info-resource-crew-needed-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ds-info-row" style="margin-bottom: 0px;">
                <ui:Label text="Crew Quarters" class="ds-info-row__label"/>
                <ui:Label name="module-info-resource-crew-quarters-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement name="module-rotation-buttons"
                              class="ds-row module-rotation-buttons--hidden ds-row__gap"
                              style="margin-top: 8px;">
                <ui:Button name="rotate-counter-button"
                           class="ds-btn ds-btn--secondary ds-btn--icon"
                           style="flex-grow: 1;">
                    <ui:VisualElement class="ds-icon ds-icon--rotate-90-degrees-ccw"/>
                </ui:Button>
                <ui:Button name="rotate-clockwise-button"
                           class="ds-btn ds-btn--secondary ds-btn--icon"
                           style="flex-grow: 1;">
                    <ui:VisualElement class="ds-icon ds-icon--rotate-90-degrees-cw"/>
                </ui:Button>
                <ui:Button name="remove-module-button"
                           class="remove-module-button--hidden ds-btn ds-btn--icon-danger ds-btn--icon"
                           style="flex-grow: 1; margin-right: 0;">
                    <ui:VisualElement class="ds-icon ds-icon--trash"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Bottom-right resources panel -->
    <ui:VisualElement name="ship-resources-panel" class="ds-card ship-resources-panel ds-col-gap">
        <ui:Label text="Ship Resources" class="ds-body-1"/>
        <ui:VisualElement class="ds-progress-row">
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Energy" class="ds-info-row__label"/>
                <ui:Label name="ship-resource-energy-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ship-resource-bar-track">
                <ui:VisualElement name="ship-resource-energy-fill" class="ship-resource-bar-fill"/>
                <ui:VisualElement name="ship-resource-energy-buffer-fill" class="ship-resource-bar-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ds-progress-row">
            <ui:VisualElement class="ds-info-row">
                <ui:Label text="Crew" class="ds-info-row__label"/>
                <ui:Label name="ship-resource-crew-value" text="-" class="ds-info-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ship-resource-bar-track">
                <ui:VisualElement name="ship-resource-crew-fill" class="ship-resource-bar-fill"/>
                <ui:VisualElement name="ship-resource-crew-buffer-fill" class="ship-resource-bar-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Bottom palette panel -->
    <ui:VisualElement name="palette-panel" class="palette-panel">
        <ui:VisualElement name="palette-tabs" class="ds-side-nav"
                          style="flex-shrink: 0; margin-top: 12px; margin-bottom: 12px; margin-left: 12px; margin-right: 8px; align-self: stretch;">
            <ui:Button name="tab-Command" class="ds-nav-item is-active">
                <ui:Label text="Command" class="ds-nav-item__label"/>
            </ui:Button>
            <ui:Button name="tab-Resources" class="ds-nav-item">
                <ui:Label text="Resources" class="ds-nav-item__label"/>
            </ui:Button>
            <ui:Button name="tab-Weapon" class="ds-nav-item">
                <ui:Label text="Weapon" class="ds-nav-item__label"/>
            </ui:Button>
            <ui:Button name="tab-Engine" class="ds-nav-item">
                <ui:Label text="Engine" class="ds-nav-item__label"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:ScrollView name="palette-scroll" horizontal-scroller-visibility="Auto"
                       vertical-scroller-visibility="Hidden" mode="Horizontal"
                       style="flex-grow: 1; margin-top: 12px; margin-bottom: 12px; margin-right: 12px;">
            <ui:VisualElement name="palette-content" class="ds-row__gap"
                              style="flex-direction: row; align-items: stretch; min-height: 0;"/>
        </ui:ScrollView>
    </ui:VisualElement>

    <!-- Input blocker toggled when rollback animation is playing -->
    <ui:VisualElement name="ship-factory-input-blocker" class="ship-factory-input-blocker"/>

    <!-- Ghost element for drag preview (hidden by default, moved to top level) -->
    <ui:VisualElement name="drag-ghost" class="drag-ghost hidden" picking-mode="Ignore"/>

    <!-- Popup feedback for actions like blocked delete attempts -->
    <ui:VisualElement name="action-popup" class="action-popup ds-toast">
        <ui:VisualElement name="action-popup-icon" class="ds-icon ds-icon--sm ds-toast__icon"/>
        <ui:Label text="" name="action-popup-label" class="ds-toast__message"/>
    </ui:VisualElement>

    <ui:VisualElement name="pause-overlay-host"
                      style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none;">
        <ui:Instance template="pauseOverlayTemplate"
                     style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;"/>
    </ui:VisualElement>

    <ui:VisualElement name="settings-overlay-host"
                      style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none;">
        <ui:Instance template="settingsOverlayTemplate"
                     style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;"/>
    </ui:VisualElement>
</ui:UXML>

