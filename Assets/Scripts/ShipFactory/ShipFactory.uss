/* Ship Factory — layout & behaviour only; visuals come from DesignSystem.uss */

:root {
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.spacer {
    flex-grow: 1;
}

/* Canvas fills space between top bar and palette */
.canvas-container {
    flex-grow: 1;
}

.canvas-viewport,
.canvas-area {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* Top bar & palette — shell geometry */
.top-bar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 8px 16px;
    flex-shrink: 0;
    background-color: var(--color-surface-elev);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.palette-panel {
    flex-direction: column;
    flex-shrink: 0;
    height: 180px;
    background-color: var(--color-surface-elev);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.palette-scroll {
    flex-grow: 1;
    padding: var(--space-3);
}

.palette-content {
    align-items: center;
    height: 100%;
}

/* Floating panels — position only; .ds-card supplies surface styling */
.module-info-panel {
    position: absolute;
    left: 16px;
    bottom: 200px;
    width: 320px;
    flex-direction: column;
}

.module-info-panel .ds-info-row__label,
.module-info-panel .ds-info-row__value {
    white-space: nowrap;
}

.ship-resources-panel {
    position: absolute;
    right: 16px;
    bottom: 200px;
    width: 280px;
    flex-direction: column;
}

.ship-resources-panel .ds-info-row {
    height: auto;
    min-height: 24px;
}

.ship-resources-panel .ds-info-row__label,
.ship-resources-panel .ds-info-row__value {
    white-space: nowrap;
}

/* Palette cards — compact .ds-animal-card; hover transition comes from Cards.uss */
.palette-content .ds-animal-card {
    width: 128px;
    flex-shrink: 0;
}

.palette-content .ds-animal-card__image {
    height: 72px;
    align-items: center;
    justify-content: center;
}

.palette-card__sprite {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
}

.palette-content .ds-animal-card__title-row {
    margin-bottom: 0;
}

.palette-content .ds-animal-card__title-row .ds-body-2 {
    margin-right: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.palette-card--dragging {
    opacity: 0.3;
}

/* Segmented resource bars — fill colours set in C# */
.ship-resource-bar-track {
    position: relative;
    height: 8px;
    overflow: hidden;
    background-color: var(--color-surface-elev);
    border-width: var(--border-thin);
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
}

.ship-resource-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

/* Toggles & overlays */
.hidden,
.module-rotation-buttons--hidden,
.remove-module-button--hidden {
    display: none;
}

.module-rotation-button {
    flex-grow: 1;
}

.module-rotation-icon--counter {
    scale: -1 1;
}

.ship-factory-input-blocker {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
}

.action-popup {
    display: none;
    position: absolute;
    left: 50%;
    top: 80px;
    translate: -50% 0;
    max-width: 600px;
}
