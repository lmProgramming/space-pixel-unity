/* ===== Ship Factory UI ===== */

/* ---------- Root: transparent except the solid bottom palette ---------- */
:root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Top bar ---------- */
.top-bar {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 6px 12px;
    background-color: rgba(12, 16, 26, 0.82);
    border-bottom-width: 2px;
    border-bottom-color: rgb(50, 60, 80);
    flex-shrink: 0;
}

.top-bar-label {
    color: rgb(200, 220, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.spacer {
    flex-grow: 1;
}

.zoom-button {
    width: 44px;
    height: 44px;
    margin-left: 6px;
    background-color: rgb(30, 38, 55);
    color: rgb(200, 220, 255);
    border-color: rgb(70, 90, 120);
    border-width: 2px;
    border-radius: 4px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.zoom-button:hover {
    background-color: rgb(50, 68, 100);
}

/* ---------- Canvas: fully transparent, pointer passthrough ---------- */
.canvas-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.canvas-viewport {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.canvas-area {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

/* Overlay indicator for modules already placed (just a thin border outline, no fill) */
.placed-module {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(80, 180, 255, 0.7);
    border-width: 2px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.placed-module:hover {
    border-color: rgb(160, 230, 255);
}

.placed-module--selected {
    border-color: rgb(255, 220, 60);
    border-width: 3px;
}

.placed-module-label {
    color: rgb(200, 230, 255);
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    overflow: hidden;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* ---------- Drag ghost ---------- */
.drag-ghost {
    position: absolute;
    background-color: rgba(80, 160, 240, 0.45);
    border-color: rgb(120, 200, 255);
    border-width: 3px;
    border-radius: 2px;
}

.hidden {
    display: none;
}

/* ---------- Palette panel — opaque strip at the bottom ---------- */
.palette-panel {
    height: 200px;
    flex-direction: column;
    background-color: rgb(14, 18, 28);
    border-top-width: 3px;
    border-top-color: rgb(50, 70, 100);
    flex-shrink: 0;
}

.palette-tabs {
    flex-direction: row;
    height: 48px;
    background-color: rgb(18, 22, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(40, 55, 80);
}

.palette-tab {
    flex-grow: 1;
    height: 48px;
    background-color: rgb(18, 22, 36);
    color: rgb(140, 165, 200);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgb(40, 55, 80);
    border-radius: 0;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.palette-tab:hover {
    background-color: rgb(30, 40, 62);
    color: rgb(200, 225, 255);
}

.palette-tab--active {
    background-color: rgb(30, 52, 90);
    color: rgb(230, 245, 255);
    border-bottom-width: 4px;
    border-bottom-color: rgb(80, 160, 240);
    -unity-font-style: bold;
}

.palette-scroll {
    flex-grow: 1;
    padding: 8px 10px;
}

.palette-content {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

/* Individual module card in the palette */
.module-card {
    width: 110px;
    height: 124px;
    margin-right: 10px;
    background-color: rgb(22, 30, 50);
    border-color: rgb(55, 75, 110);
    border-width: 2px;
    border-radius: 6px;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 6px;
    flex-shrink: 0;
}

.module-card:hover {
    background-color: rgb(35, 52, 85);
    border-color: rgb(100, 160, 230);
}

.module-card--dragging {
    opacity: 0.4;
}

.module-card-icon {
    width: 70px;
    height: 70px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.module-card-label {
    color: rgb(190, 215, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
    width: 100%;
    padding-left: 4px;
    padding-right: 4px;
}
