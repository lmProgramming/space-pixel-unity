/* ===== Ship Factory UI ===== */

/* ---------- Root: transparent except the solid bottom palette ---------- */
:root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Top bar ---------- */
.top-bar {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 6px 12px;
    background-color: rgba(12, 16, 26, 0.82);
    border-bottom-width: 2px;
    border-bottom-color: rgb(50, 60, 80);
    flex-shrink: 0;
}

.top-bar-label {
    color: rgb(200, 220, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.spacer {
    flex-grow: 1;
}

.ship-name-field {
    min-width: 260px;
    margin-right: 8px;
}

.ship-name-field .unity-base-text-field__label {
    color: rgb(188, 212, 246);
    min-width: 46px;
}

.ship-name-field .unity-base-text-field__input {
    background-color: rgb(26, 34, 52);
    border-color: rgb(70, 95, 140);
    border-width: 1px;
    color: rgb(230, 242, 255);
}

.save-ship-button {
    height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(34, 90, 146);
    border-color: rgb(90, 160, 230);
    border-width: 2px;
    color: rgb(232, 245, 255);
    -unity-font-style: bold;
}

.save-ship-button:hover {
    background-color: rgb(56, 120, 188);
}

.zoom-button {
    width: 44px;
    height: 44px;
    margin-left: 6px;
    background-color: rgb(30, 38, 55);
    color: rgb(200, 220, 255);
    border-color: rgb(70, 90, 120);
    border-width: 2px;
    border-radius: 4px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.zoom-button:hover {
    background-color: rgb(50, 68, 100);
}

/* ---------- Canvas: fully transparent, pointer passthrough ---------- */
.canvas-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.canvas-viewport {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.canvas-area {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

/* Overlay indicator for modules already placed (just a thin border outline, no fill) */
.placed-module {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(80, 180, 255, 0.7);
    border-width: 2px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.placed-module--inside-other {
    background-color: rgba(255, 0, 0, 0.2);
    border-color: rgb(255, 0, 0);
}

.placed-module--outside-ship {
    background-color: rgba(255, 0, 0, 0.1);
    border-color: rgb(255, 0, 0);
}

.placed-module:hover {
    border-color: rgb(160, 230, 255);
}

.placed-module--selected {
    border-color: rgb(255, 220, 60);
    border-width: 3px;
}

.placed-module-label {
    color: rgb(200, 230, 255);
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
    overflow: hidden;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* ---------- Palette panel - opaque strip at the bottom ---------- */
.palette-panel {
    height: 200px;
    flex-direction: column;
    background-color: rgb(14, 18, 28);
    border-top-width: 3px;
    border-top-color: rgb(50, 70, 100);
    flex-shrink: 0;
}

.palette-tabs {
    flex-direction: row;
    height: 48px;
    background-color: rgb(18, 22, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(40, 55, 80);
}

.palette-tab {
    flex-grow: 1;
    height: 48px;
    background-color: rgb(18, 22, 36);
    color: rgb(140, 165, 200);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgb(40, 55, 80);
    border-radius: 0;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.palette-tab:hover {
    background-color: rgb(30, 40, 62);
    color: rgb(200, 225, 255);
}

.palette-tab--active {
    background-color: rgb(30, 52, 90);
    color: rgb(230, 245, 255);
    border-bottom-width: 4px;
    border-bottom-color: rgb(80, 160, 240);
    -unity-font-style: bold;
}

.palette-scroll {
    flex-grow: 1;
    padding: 8px 10px;
}

.palette-content {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

/* Individual module card in the palette */
.module-card {
    width: 110px;
    height: 124px;
    margin-right: 10px;
    background-color: rgb(22, 30, 50);
    border-color: rgb(55, 75, 110);
    border-width: 2px;
    border-radius: 6px;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 6px;
    flex-shrink: 0;
}

.module-card:hover {
    background-color: rgb(35, 52, 85);
    border-color: rgb(100, 160, 230);
}

.module-card--dragging {
    opacity: 0.4;
}

.module-card-icon {
    width: 70px;
    height: 70px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.module-card-label {
    color: rgb(190, 215, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
    width: 100%;
    padding-left: 4px;
    padding-right: 4px;
}

.module-info-panel {
    position: absolute;
    left: 12px;
    bottom: 212px;
    width: 360px;
    min-height: 192px;
    padding: 10px;
    background-color: rgba(8, 16, 34, 0.98);
    border-color: rgb(92, 128, 186);
    border-width: 2px;
    border-radius: 6px;
}

.module-info-foldout {
    margin-bottom: 6px;
    color: rgb(228, 240, 255);
    background-color: rgba(28, 42, 74, 0.95);
    border-color: rgb(102, 140, 200);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px;
}

.module-info-foldout > .unity-foldout__toggle {
    color: rgb(242, 249, 255);
    -unity-font-style: bold;
    background-color: rgba(48, 68, 108, 0.96);
    padding-left: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.module-info-foldout .unity-foldout__text {
    color: rgb(242, 249, 255);
}

.module-info-title {
    color: rgb(214, 232, 255);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.module-info-name {
    color: rgb(246, 252, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.module-info-field {
    color: rgb(214, 232, 255);
    font-size: 13px;
    margin-bottom: 2px;
}

.module-info-description {
    color: rgb(226, 239, 255);
    font-size: 12px;
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: normal;
}

.remove-module-button {
    height: 32px;
    margin-top: 4px;
    background-color: rgb(112, 45, 52);
    border-color: rgb(188, 84, 97);
    border-width: 1px;
    color: rgb(255, 232, 232);
    -unity-font-style: bold;
}

.remove-module-button:hover {
    background-color: rgb(142, 58, 67);
}

.remove-module-button--hidden {
    display: none;
}

.ship-resources-panel {
    position: absolute;
    right: 12px;
    bottom: 212px;
    width: 320px;
    padding: 10px;
    background-color: rgba(8, 16, 34, 0.98);
    border-color: rgb(92, 128, 186);
    border-width: 2px;
    border-radius: 6px;
}

.ship-resources-title {
    color: rgb(226, 240, 255);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.ship-resource-row {
    margin-bottom: 8px;
}

.ship-resource-label {
    color: rgb(214, 232, 255);
    font-size: 12px;
    margin-bottom: 4px;
}

.ship-resource-bar-track {
    height: 14px;
    border-color: rgb(72, 92, 126);
    border-width: 1px;
    border-radius: 4px;
    background-color: rgb(16, 25, 42);
    overflow: hidden;
}

.ship-resource-bar-fill {
    height: 100%;
    width: 0;
}

.ship-resource-bar-fill--energy {
    background-color: rgb(80, 172, 250);
}

.ship-resource-bar-fill--crew {
    background-color: rgb(136, 208, 116);
}

.ship-factory-input-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    display: none;
}

.action-popup {
    position: absolute;
    left: 50%;
    top: 74px;
    translate: -50% 0;
    max-width: 420px;
    padding: 8px 12px;
    background-color: rgba(18, 30, 55, 0.95);
    border-color: rgb(120, 170, 230);
    border-width: 2px;
    border-radius: 6px;
    display: none;
}

.action-popup--warning {
    background-color: rgba(70, 55, 16, 0.96);
    border-color: rgb(236, 196, 96);
}

.action-popup--warning .action-popup-label {
    color: rgb(255, 242, 194);
}

.action-popup--error {
    background-color: rgba(80, 22, 30, 0.96);
    border-color: rgb(244, 112, 132);
}

.action-popup--error .action-popup-label {
    color: rgb(255, 220, 226);
}

.action-popup-label {
    color: rgb(234, 245, 255);
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}
