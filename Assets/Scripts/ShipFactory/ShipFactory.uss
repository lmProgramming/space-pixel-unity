/* Ship Factory — layout & behaviour only; visuals from DesignSystem.uss */

:root {
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.spacer {
    flex-grow: 1;
}

.canvas-container {
    flex-grow: 1;
}

.canvas-viewport,
.canvas-area {
    position: absolute;
    width: 100%;
    height: 100%;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 8px 16px;
    flex-shrink: 0;
    background-color: var(--color-surface-elev);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.palette-panel {
    flex-direction: row;
    flex-shrink: 0;
    height: 220px;
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.module-info-panel,
.ship-resources-panel {
    position: absolute;
    flex-direction: column;
    bottom: 236px;
    width: 300px;
}

.module-info-panel {
    left: 16px;
    margin-bottom: 0;
    padding-bottom: 0;
}

.ship-resources-panel {
    right: 16px;
}

.ship-resource-bar-track {
    position: relative;
    height: 8px;
    overflow: hidden;
    background-color: var(--color-surface-elev);
    border-width: var(--border-thin);
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
}

.ship-resource-bar-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

.hidden,
.module-rotation-buttons--hidden,
.remove-module-button--hidden,
.ship-factory-input-blocker,
.action-popup {
    display: none;
}

.module-rotation-icon--counter {
    scale: -1 1;
}

.ship-factory-input-blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
}

.action-popup {
    position: absolute;
    left: 50%;
    top: 80px;
    translate: -50% 0;
    max-width: 600px;
}

.palette-card--dragging {
    opacity: 0.3;
}

.module-info-description-scroll {
    flex-shrink: 0;
    max-height: 48px;
}

.module-info-description {
    white-space: normal;
}
