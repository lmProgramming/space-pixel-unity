<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="ShipStatusPanel.uss" />
    <ui:VisualElement name="ship-status-panel" class="ship-status-panel">
        <!-- Energy Bar (Vertical) -->
        <ui:VisualElement name="energy-bar-container" class="energy-bar-container">
            <ui:VisualElement name="energy-bar-background" class="energy-bar-background">
                <ui:VisualElement name="energy-bar-fill" class="energy-bar-fill" />
                <ui:VisualElement name="energy-bar-glow" class="energy-bar-glow" />
            </ui:VisualElement>
            <!-- Flow indicator (arrow or glow showing +/-) -->
            <ui:VisualElement name="energy-flow-indicator" class="energy-flow-indicator">
                <ui:Label name="energy-flow-label" text="+" class="energy-flow-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        
        <!-- Crew Counter (tiny, at bottom) -->
        <ui:VisualElement name="crew-section" class="crew-section">
            <ui:Label name="crew-count-label" text="24" class="crew-count" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
