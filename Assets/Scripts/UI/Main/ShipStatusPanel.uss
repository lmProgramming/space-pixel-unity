/* Ship Status Panel - Retro Mobile Style */

.ship-status-panel {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 52px;
    height: 400px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

/* Vertical Energy Bar - Chunky Retro Style */
.energy-bar-container {
    width: 100%;
    height: 300px;
    flex-direction: column;
    align-items: center;
}

.energy-bar-background {
    width: 32px;
    height: 100%;
    background-color: rgb(15, 15, 25);
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(60, 70, 90);
    overflow: hidden;
    flex-direction: column-reverse;
}

.energy-bar-fill {
    width: 100%;
    height: 50%;
    background-color: rgb(50, 180, 220);
    border-radius: 0;
    transition-property: height, background-color;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.energy-bar-glow {
    position: absolute;
    left: 3px;
    right: 3px;
    bottom: 3px;
    height: 50%;
    background-color: rgba(120, 220, 255, 0.2);
    border-radius: 0;
    transition-property: height;
    transition-duration: 0.25s;
}

/* Energy Flow Indicator - Big Retro Box */
.energy-flow-indicator {
    width: 52px;
    height: 32px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgb(15, 15, 25);
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(60, 70, 90);
    flex-shrink: 0;
}

.energy-flow-label {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(80, 255, 120);
    transition-property: color;
    transition-duration: 0.15s;
}

.energy-flow-label.negative {
    color: rgb(255, 80, 80);
}

.energy-flow-label.neutral {
    color: rgb(120, 120, 140);
}

/* Crew Section - Retro Counter */
.crew-section {
    width: 52px;
    height: 36px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgb(15, 15, 25);
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(180, 150, 60);
    flex-shrink: 0;
}

.crew-count {
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(255, 210, 80);
    -unity-font-style: bold;
    transition-property: scale, color;
    transition-duration: 0.1s;
}

/* State Classes - Bold Retro Colors */
.energy-critical .energy-bar-background {
    border-color: rgb(200, 50, 50);
}

.energy-critical .energy-bar-fill {
    background-color: rgb(220, 60, 60);
}

.energy-gaining .energy-bar-fill {
    background-color: rgb(60, 220, 100);
}

.energy-gaining .energy-bar-background {
    border-color: rgb(50, 180, 80);
}

.energy-draining .energy-bar-fill {
    background-color: rgb(220, 140, 50);
}

.energy-draining .energy-bar-background {
    border-color: rgb(180, 110, 40);
}

.pulse {
    scale: 1.1;
}
