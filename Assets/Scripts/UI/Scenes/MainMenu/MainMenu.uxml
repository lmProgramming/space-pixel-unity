<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/DesignSystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss"/>
    <Style src="MainMenu.uss"/>

    <ui:VisualElement name="main-menu-root" class="ds-root ds-root--transparent"
                      style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:VisualElement name="main-menu-panel" class="ds-modal" style="width: 520px; max-width: 520px;">
            <ui:Label text="Space Pixel" class="ds-h1" style="unity-text-align: middle-center; margin-bottom: 4px;"/>
            <ui:Label text="Main Menu" class="ds-body-1 ds-text-primary"
                      style="unity-text-align: middle-center; margin-bottom: 12px; opacity: 0.9;"/>

            <ui:Button name="progression-button" text="Progression" class="ds-btn ds-btn--primary ds-btn--block"
                       style="margin-bottom: 8px;"/>
            <ui:Button name="start-button" text="Free Mode" class="ds-btn ds-btn--secondary ds-btn--block"
                       style="margin-bottom: 8px;"/>
            <ui:Button name="ship-factory-button" text="ShipFactory" class="ds-btn ds-btn--secondary ds-btn--block"
                       style="margin-bottom: 8px;"/>
            <ui:Button name="settings-button" text="Settings" class="ds-btn ds-btn--secondary ds-btn--block"
                       style="margin-bottom: 8px;"/>
            <ui:Button name="quit-button" text="Quit" class="ds-btn ds-btn--danger ds-btn--block"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
